/* SPDX-License-Identifier: Apache-2.0
 * Production main.c shell policies against the actual display implementation.
 * Generated by test_shell_input.py; __PRODUCTION_HELPERS__ comes from main.c.
 */

#define main existing_shell_test_main
#include "test_shell.c"
#undef main
#include <stdatomic.h>
#include "jr_ports/input.h"
static _Atomic bool s_ui_shade_open;
__PRODUCTION_HELPERS__

static void prepare_panel(jr_display_space_t panel, bool desk_active)
{
    reset_nav();
    s_ui_shade_open = false;
    jr_display_set_shell_state(false, desk_active, 40U,
        desk_active ? JR_DISPLAY_AGENT_WORKING : JR_DISPLAY_AGENT_NONE);
    jr_display_nav_set(panel);
    jr_display_caption_set("DETAIL - DOWN TO CLOSE");
}

static void check_panel_caption(jr_display_space_t panel)
{
    static const char *const labels[] =
        {"JARVIS", "", "WEATHER", "STATUS", "DESK", "ACTIVITY"};
    if (panel == JR_DISPLAY_SPACE_WATCH) {
        CHECK(!s_caption_on, "WATCH dismissal must clear the caption");
    } else {
        CHECK(s_caption_on, "panel %d caption active", (int)panel);
        CHECK(strcmp(s_caption_text, labels[panel]) == 0,
              "panel %d dismissal names panel, got %s", (int)panel,
              s_caption_text);
    }
}

static void test_detail_down_retains_panel(void)
{
    for (int p = JR_DISPLAY_SPACE_WATCH; p < JR_DISPLAY_SPACE_COUNT; ++p) {
        const jr_display_space_t panel = (jr_display_space_t)p;
        prepare_panel(panel, true);
        jr_display_nav_up();
        CHECK(jr_display_nav_overlay() == JR_DISPLAY_OVERLAY_DETAIL,
              "panel %d detail opened", p);
        shell_vertical_navigation(JR_INPUT_DIRECTION_DOWN);
        CHECK(jr_display_nav_overlay() == JR_DISPLAY_OVERLAY_NONE,
              "panel %d DOWN closes detail", p);
        CHECK(jr_display_nav_space() == panel,
              "panel %d DOWN retains underlying panel", p);
        shell_caption_space();
        check_panel_caption(panel);
        shell_vertical_navigation(JR_INPUT_DIRECTION_DOWN);
        CHECK(jr_display_nav_space() ==
                  (jr_display_space_t)((p + 1) % JR_DISPLAY_SPACE_COUNT),
              "panel %d following DOWN resumes the mode ring", p);
    }
}

static void test_outside_detail_dismiss_names_panel(void)
{
    for (int p = JR_DISPLAY_SPACE_WATCH; p < JR_DISPLAY_SPACE_COUNT; ++p) {
        const jr_display_space_t panel = (jr_display_space_t)p;
        prepare_panel(panel, true);
        jr_display_nav_up();
        CHECK(jr_display_hit(233, 100) == JR_DISPLAY_ACT_DISMISS,
              "panel %d outside-sheet tap routes to DISMISS", p);
        CHECK(jr_display_hit(233, 233) == JR_DISPLAY_ACT_NONE,
              "panel %d sheet centre keeps its existing action", p);
        shell_dismiss();
        CHECK(jr_display_nav_overlay() == JR_DISPLAY_OVERLAY_NONE,
              "panel %d outside-sheet tap closes detail", p);
        CHECK(jr_display_nav_space() == panel,
              "panel %d outside-sheet tap retains panel", p);
        CHECK(!s_ui_shade_open, "panel %d dismissal does not open controls", p);
        check_panel_caption(panel);
    }
}

static void test_ordinary_ring_and_existing_up(void)
{
    const jr_display_space_t dark[] = {
        JR_DISPLAY_SPACE_JARVIS, JR_DISPLAY_SPACE_WATCH,
        JR_DISPLAY_SPACE_WEATHER, JR_DISPLAY_SPACE_STATUS,
        JR_DISPLAY_SPACE_ACTIVITY,
    };
    const jr_display_space_t live[] = {
        JR_DISPLAY_SPACE_JARVIS, JR_DISPLAY_SPACE_WATCH,
        JR_DISPLAY_SPACE_WEATHER, JR_DISPLAY_SPACE_STATUS,
        JR_DISPLAY_SPACE_DESK, JR_DISPLAY_SPACE_ACTIVITY,
    };
    for (int active = 0; active <= 1; ++active) {
        const jr_display_space_t *ring = active ? live : dark;
        const size_t count = active ? sizeof live / sizeof live[0]
                                    : sizeof dark / sizeof dark[0];
        prepare_panel(JR_DISPLAY_SPACE_JARVIS, active != 0);
        for (size_t i = 0; i < count; ++i) {
            shell_vertical_navigation(JR_INPUT_DIRECTION_DOWN);
            CHECK(jr_display_nav_space() == ring[(i + 1U) % count],
                  "desk=%d ordinary DOWN walks and wraps ring step %zu", active, i);
            CHECK(jr_display_nav_overlay() == JR_DISPLAY_OVERLAY_NONE,
                  "ordinary DOWN stays on a normal panel");
        }
        for (size_t i = 0; i < count; ++i) {
            shell_vertical_navigation(JR_INPUT_DIRECTION_UP);
            CHECK(jr_display_nav_space() == ring[count - 1U - i],
                  "desk=%d ordinary UP walks and wraps ring step %zu", active, i);
        }
    }
    prepare_panel(JR_DISPLAY_SPACE_STATUS, true);
    jr_display_nav_up();
    shell_vertical_navigation(JR_INPUT_DIRECTION_UP);
    CHECK(jr_display_nav_space() == JR_DISPLAY_SPACE_WEATHER,
          "UP from a detail keeps its existing previous-panel behavior");
    CHECK(jr_display_nav_overlay() == JR_DISPLAY_OVERLAY_NONE,
          "UP from detail closes the old detail");
}

static void test_dismiss_preserves_both_shade_doors(void)
{
    prepare_panel(JR_DISPLAY_SPACE_STATUS, true);
    jr_display_nav_down();
    s_ui_shade_open = true;
    shell_dismiss();
    CHECK(jr_display_nav_overlay() == JR_DISPLAY_OVERLAY_NONE,
          "nav-opened shade closes");
    CHECK(!s_ui_shade_open, "nav-opened shade clears the shell flag");
    CHECK(strcmp(s_caption_text, "CONTROLS CLOSED") == 0,
          "nav-opened shade keeps its existing caption");
    CHECK(jr_display_nav_space() == JR_DISPLAY_SPACE_STATUS,
          "nav shade close preserves panel");

    prepare_panel(JR_DISPLAY_SPACE_STATUS, true);
    s_ui_shade_open = true;
    jr_display_set_shell_state(true, true, 40U, JR_DISPLAY_AGENT_WORKING);
    shell_dismiss();
    CHECK(!s_ui_shade_open, "HTTP-opened shade clears its shell flag");
    jr_display_set_shell_state(s_ui_shade_open, true, 40U,
                               JR_DISPLAY_AGENT_WORKING);
    CHECK(!sp_shade_open(), "HTTP-opened shade is closed after publish");
    CHECK(jr_display_nav_overlay() == JR_DISPLAY_OVERLAY_NONE,
          "HTTP-opened shade does not open a nav shade");
    CHECK(strcmp(s_caption_text, "CONTROLS CLOSED") == 0,
          "HTTP-opened shade keeps its existing caption");
    CHECK(jr_display_nav_space() == JR_DISPLAY_SPACE_STATUS,
          "HTTP shade close preserves panel");

    prepare_panel(JR_DISPLAY_SPACE_STATUS, true);
    shell_dismiss();
    CHECK(jr_display_nav_overlay() == JR_DISPLAY_OVERLAY_SHADE,
          "existing overlay-free fallback still opens shade");
    CHECK(strcmp(s_caption_text, "CONTROLS - UP TO CLOSE") == 0,
          "existing overlay-free fallback keeps its caption");
}

int main(void)
{
    test_detail_down_retains_panel();
    test_outside_detail_dismiss_names_panel();
    test_ordinary_ring_and_existing_up();
    test_dismiss_preserves_both_shade_doors();
    if (g_failures) {
        printf("%d failure(s) of %d checks\n", g_failures, g_checks);
        return 1;
    }
    printf("main shell tests passed (%d checks)\n", g_checks);
    return g_checks > 0 ? 0 : 1;
}
