/* SPDX-License-Identifier: Apache-2.0
 * main/device_tools.c's board_maybe_poll against stubs: with no gateway key
 * the device never dials, and with one it still does.
 * Generated by test_board_gate.py; __PRODUCTION_HELPERS__ comes from
 * device_tools.c. No key, token or address appears here: the stubs only say
 * whether a gateway is configured.
 */
#include <stdatomic.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include "jr_core/mood.h"

#define esp_err_t int
#define ESP_OK 0
#define JR_TOOLS_SESSION_ANY 0u

typedef struct {
    uint32_t call_id;
    const char *call_id_text;
    const char *name;
    const char *args_json;
    uint32_t session_gen;
} jr_tool_job_t;
typedef struct { bool sta_connected; } jr_net_status_t;

struct { _Atomic bool worker_ready; } s_tool_diag;
_Atomic uint8_t s_mood_id;

static bool g_configured;
static bool g_wifi = true;
static int g_submits;
static const char *g_last_name;
bool jr_tools_is_configured(void) { return g_configured; }
esp_err_t jr_net_get_status(jr_net_status_t *s) { s->sta_connected = g_wifi; return ESP_OK; }
esp_err_t jr_tools_submit(const jr_tool_job_t *job)
{
    ++g_submits;
    g_last_name = job->name;
    return ESP_OK;
}

#define LOCAL_BOARD_CALL_ID   0x4C425244u
#define LOCAL_BOARD_CALL_TEXT "local:board"
#define BOARD_POLL_MS         90000u
#define BOARD_FIRST_POLL_MS   30000u

static uint32_t s_board_last_poll_ms;
static bool     s_board_inflight;
/* The gateway's health picks the cadence: 90 s normally, much longer once it
 * has stopped answering. The test says which; the policy is host-tested. */
#define DEGRADED_POLL_MS 900000u
static uint32_t g_poll_ms = BOARD_POLL_MS;
uint32_t device_gateway_poll_ms(void) { return g_poll_ms; }
__PRODUCTION_HELPERS__

static int g_checks, g_failures;
#define CHECK(cond, ...) do { ++g_checks; if (!(cond)) { ++g_failures; \
    printf("FAIL line %d: ", __LINE__); printf(__VA_ARGS__); printf("\n"); } } while (0)

static void reset(void)
{
    g_configured = false;
    g_poll_ms = BOARD_POLL_MS;
    g_wifi = true;
    g_submits = 0;
    g_last_name = NULL;
    s_board_last_poll_ms = 0;
    s_board_inflight = false;
    atomic_store(&s_tool_diag.worker_ready, true);
    atomic_store(&s_mood_id, (uint8_t)JR_MOOD_AWAKE);
}

static void test_no_key_never_dials(void)
{
    reset();
    for (uint32_t t = 0; t < 40u * BOARD_POLL_MS; t += 1000u) {
        board_maybe_poll(t);
    }
    CHECK(g_submits == 0, "without a gateway key nothing is submitted, got %d",
          g_submits);
    CHECK(!s_board_inflight, "no poll is left in flight");
    CHECK(s_board_last_poll_ms == 0u, "the poll clock never starts");
}

static void test_with_key_still_polls_on_schedule(void)
{
    reset();
    g_configured = true;
    board_maybe_poll(BOARD_FIRST_POLL_MS - 1u);
    CHECK(g_submits == 0, "not before the first-poll delay");
    board_maybe_poll(BOARD_FIRST_POLL_MS);
    CHECK(g_submits == 1, "first poll at the delay, got %d", g_submits);
    CHECK(g_last_name != NULL && g_last_name[0] == 'b', "it is the board poll");
    s_board_inflight = false;
    board_maybe_poll(BOARD_FIRST_POLL_MS + BOARD_POLL_MS - 1u);
    CHECK(g_submits == 1, "not before the interval");
    board_maybe_poll(BOARD_FIRST_POLL_MS + BOARD_POLL_MS);
    CHECK(g_submits == 2, "again after the interval, got %d", g_submits);
}

static void test_key_removed_later_stops_the_dialling(void)
{
    reset();
    g_configured = true;
    board_maybe_poll(BOARD_FIRST_POLL_MS);
    s_board_inflight = false;
    g_configured = false;
    board_maybe_poll(BOARD_FIRST_POLL_MS + 2u * BOARD_POLL_MS);
    CHECK(g_submits == 1, "a cleared key stops the next poll, got %d", g_submits);
}

/* A gateway that does not resolve was polled every 90 s all boot long. */
static void test_unreachable_gateway_is_probed_slowly(void)
{
    reset();
    g_configured = true;
    board_maybe_poll(BOARD_FIRST_POLL_MS);
    CHECK(g_submits == 1, "the first poll still goes, got %d", g_submits);
    s_board_inflight = false;
    g_poll_ms = DEGRADED_POLL_MS;
    board_maybe_poll(BOARD_FIRST_POLL_MS + BOARD_POLL_MS);
    CHECK(g_submits == 1, "no poll at the normal interval once it is "
          "unreachable, got %d", g_submits);
    board_maybe_poll(BOARD_FIRST_POLL_MS + DEGRADED_POLL_MS - 1u);
    CHECK(g_submits == 1, "none just before the probe interval");
    board_maybe_poll(BOARD_FIRST_POLL_MS + DEGRADED_POLL_MS);
    CHECK(g_submits == 2, "one probe at the long interval, got %d", g_submits);
}

static void test_whisper_and_dream_suppress_board_poll(void)
{
    reset();
    g_configured = true;
    atomic_store(&s_mood_id, (uint8_t)JR_MOOD_WHISPER);
    board_maybe_poll(BOARD_FIRST_POLL_MS);
    CHECK(g_submits == 0, "WHISPER must suppress board poll, got %d", g_submits);
    atomic_store(&s_mood_id, (uint8_t)JR_MOOD_DREAM);
    board_maybe_poll(BOARD_FIRST_POLL_MS + BOARD_POLL_MS);
    CHECK(g_submits == 0, "DREAM must suppress board poll, got %d", g_submits);
    atomic_store(&s_mood_id, (uint8_t)JR_MOOD_AWAKE);
    board_maybe_poll(BOARD_FIRST_POLL_MS + BOARD_POLL_MS);
    CHECK(g_submits == 1, "AWAKE resumes board poll, got %d", g_submits);
}

int main(void)
{
    test_unreachable_gateway_is_probed_slowly();
    test_no_key_never_dials();
    test_with_key_still_polls_on_schedule();
    test_key_removed_later_stops_the_dialling();
    test_whisper_and_dream_suppress_board_poll();
    if (g_failures != 0 || g_checks == 0) {
        printf("%d failure(s) of %d checks\n", g_failures, g_checks);
        return 1;
    }
    printf("board poll gate passed (%d checks)\n", g_checks);
    return 0;
}
