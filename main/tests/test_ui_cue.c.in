/* SPDX-License-Identifier: Apache-2.0
 * main.c's interface-cue wiring against the real jr_cue.c gate.
 * Generated by test_ui_cue.py; __PRODUCTION_HELPERS__ comes from main.c.
 */
#include <stdatomic.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include "jr_core/cue.h"

/* ---- stubs for what main.c owns ---- */
typedef struct { int orch; } jr_app_t;
jr_app_t s_app;
jr_mood_state_t s_mood;
_Atomic bool s_ui_sounds = true;
_Atomic bool s_ota_active;
_Atomic bool s_voice_privacy_paused;
bool s_flip_muted;
int s_out_vol = 100;
static jr_state_t g_phase = JR_ST_IDLE;
static int64_t g_now_us = 5000000;
jr_state_t jr_orch_phase(const void *orch) { (void)orch; return g_phase; }
int64_t esp_timer_get_time(void) { return g_now_us; }

static int g_plays;
static jr_cue_kind_t g_last_kind;
static uint16_t g_last_amp;
int jr_audio_play_cue(jr_cue_kind_t kind, uint16_t amp)
{
    ++g_plays;
    g_last_kind = kind;
    g_last_amp = amp;
    return 0;
}
#define s_cue_gate_reset() (s_cue_gate = (jr_cue_gate_t){0})

static jr_cue_gate_t s_cue_gate;
__PRODUCTION_HELPERS__

static int g_checks, g_failures;
#define CHECK(cond, ...) do { ++g_checks; if (!(cond)) { ++g_failures; \
    printf("FAIL line %d: ", __LINE__); printf(__VA_ARGS__); printf("\n"); } } while (0)

static void reset(void)
{
    g_plays = 0;
    g_phase = JR_ST_IDLE;
    s_mood.mood = JR_MOOD_AWAKE;
    atomic_store(&s_ui_sounds, true);
    atomic_store(&s_ota_active, false);
    atomic_store(&s_voice_privacy_paused, false);
    s_flip_muted = false;
    s_out_vol = 100;
    g_now_us += 1000000;   /* clear any tick window */
    s_cue_gate_reset();
}

static void test_physical_touch_plays(void)
{
    reset();
    ui_cue(JR_CUE_CONFIRM, true);
    CHECK(g_plays == 1, "a physical cue plays, plays=%d", g_plays);
    CHECK(g_last_kind == JR_CUE_CONFIRM, "kind is carried");
    CHECK(g_last_amp > 0 && g_last_amp <= JR_CUE_MAX_PERMILLE,
          "amplitude %u within the cap", (unsigned)g_last_amp);
}

static void test_synthetic_input_never_plays(void)
{
    for (int k = 0; k < JR_CUE_KIND_COUNT; ++k) {
        reset();
        ui_cue((jr_cue_kind_t)k, false);
        CHECK(g_plays == 0, "injected input must stay silent (kind %d)", k);
    }
    reset();
    ui_level_cue(100, 1, false);
    CHECK(g_plays == 0, "an injected slider push stays silent");
}

static void test_owner_mute_and_flip_silence_the_cue(void)
{
    reset();
    atomic_store(&s_voice_privacy_paused, true);
    ui_cue(JR_CUE_DISMISS, true);
    CHECK(g_plays == 0, "privacy pause silences cues");
    reset();
    s_flip_muted = true;
    ui_cue(JR_CUE_DISMISS, true);
    CHECK(g_plays == 0, "the flip latch silences cues");
}

static void test_setting_phase_mood_ota_gate(void)
{
    reset();
    atomic_store(&s_ui_sounds, false);
    ui_cue(JR_CUE_TICK, true);
    CHECK(g_plays == 0, "ui_sounds off");
    reset();
    g_phase = JR_ST_SPEAKING;
    ui_cue(JR_CUE_TICK, true);
    CHECK(g_plays == 0, "no cue over the assistant's voice");
    reset();
    g_phase = JR_ST_LISTENING;
    ui_cue(JR_CUE_TICK, true);
    CHECK(g_plays == 0, "no cue into an open microphone");
    reset();
    s_mood.mood = JR_MOOD_DREAM;
    ui_cue(JR_CUE_TICK, true);
    CHECK(g_plays == 0, "no cue in DREAM");
    reset();
    s_mood.mood = JR_MOOD_WHISPER;
    ui_cue(JR_CUE_TICK, true);
    CHECK(g_plays == 0, "no cue in WHISPER");
    reset();
    atomic_store(&s_ota_active, true);
    ui_cue(JR_CUE_TICK, true);
    CHECK(g_plays == 0, "no cue during an update");
}

static void test_tick_rate_limit_through_the_real_clock_read(void)
{
    reset();
    ui_cue(JR_CUE_TICK, true);
    g_now_us += 100000;            /* +100 ms */
    ui_cue(JR_CUE_TICK, true);
    CHECK(g_plays == 1, "second tick inside 120 ms is dropped, plays=%d", g_plays);
    g_now_us += 30000;             /* +130 ms from the first */
    ui_cue(JR_CUE_TICK, true);
    CHECK(g_plays == 2, "a tick after the window plays, plays=%d", g_plays);
}

static void test_level_stops_say_limit_only_at_the_end(void)
{
    reset();
    ui_level_cue(95, 1, true);
    CHECK(g_plays == 0, "mid-range push is silent");
    ui_level_cue(100, 1, true);
    CHECK(g_plays == 1 && g_last_kind == JR_CUE_LIMIT, "top stop is a limit");
    reset();
    ui_level_cue(10, -1, true);
    CHECK(g_plays == 1 && g_last_kind == JR_CUE_LIMIT, "bottom stop is a limit");
    reset();
    ui_level_cue(10, 1, true);
    CHECK(g_plays == 0, "leaving the bottom is not a limit");
}

int main(void)
{
    test_physical_touch_plays();
    test_synthetic_input_never_plays();
    test_owner_mute_and_flip_silence_the_cue();
    test_setting_phase_mood_ota_gate();
    test_tick_rate_limit_through_the_real_clock_read();
    test_level_stops_say_limit_only_at_the_end();
    if (g_failures != 0 || g_checks == 0) {
        printf("%d failure(s) of %d checks\n", g_failures, g_checks);
        return 1;
    }
    printf("ui cue wiring passed (%d checks)\n", g_checks);
    return 0;
}
