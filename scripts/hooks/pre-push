#!/usr/bin/env bash
# Opt-in pre-push guard. Install: scripts/hooks/install.sh
# Scans only what this push adds (git feeds "<lref> <lsha> <rref> <rsha>" lines
# on stdin), so known pre-guard history hits never block a push.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
ZERO=0000000000000000000000000000000000000000

"$ROOT/scripts/check-secrets.sh"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks not installed; only check-secrets.sh ran (CI runs gitleaks)." >&2
  exit 0
fi

status=0
while read -r _lref lsha _rref rsha; do
  [ -n "${lsha:-}" ] || continue
  [ "$lsha" = "$ZERO" ] && continue                 # branch delete: nothing to scan
  if [ "$rsha" = "$ZERO" ]; then
    range="$lsha --not --remotes"                   # new branch: commits on no remote ref
    [ -n "$(git rev-list -1 "$lsha" --not --remotes)" ] || continue
  else
    range="$rsha..$lsha"
  fi
  # shellcheck disable=SC2086  # range is intentionally split into rev args
  gitleaks detect --source . --config .gitleaks.toml --redact --no-banner \
    --log-opts="$range" || status=1
done
exit "$status"
