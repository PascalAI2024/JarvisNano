# Waveshare ESP32-S3-Touch-AMOLED-1.75
# ESP32-S3R8: 16 MB flash, 8 MB octal PSRAM
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 16 MB QIO flash @ 80 MHz
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 8 MB octal PSRAM @ 80 MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# USB: native USB-Serial/JTAG console for monitor/log over the same cable used to flash.
# Without this the board enumerates as JTAG-only and there is no /dev/cu.usbmodem* after flash —
# you would have to hold BOOT + replug for every reflash. Confirmed: factory firmware ships
# without this enabled, which is why the new unit only enumerates in download mode.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Display backed by LCD subsystem.
CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUPPORT=y

# Board-manager peripheral support flags (required by esp-bmgr-assist >= 0.8 — earlier
# versions inferred these from board_peripherals.yaml; newer versions need them explicit).
CONFIG_ESP_BOARD_PERIPH_I2C_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_SPI_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_GPIO_SUPPORT=y

# Audio: I2S0 duplex driving ES8311 codec (out) + ES7210 ADC (in). The ES7210
# digitizes a hardware echo-reference on MIC3; AEC itself is software (esp-sr).
CONFIG_ESP_BOARD_PERIPH_I2S_SUPPORT=y

# Touch screen (CST9217 has known broken READ_ID register; skip the probe).
# Matches the pattern esp_vocat uses for CST816S.

CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# The AMOLED/emote path is timing-sensitive. Debug optimization (-O0) makes the
# face look broken even when the rendering code is correct.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_LEVEL_RELEASE=y

# lwIP TCP TX buffer + window (root-cause #1, Part B). The default send buffer is
# 5760 B (4xMSS). A Wi-Fi RTT spike fills it, the WS poll-write times out and
# returns 0, and esp_websocket_client treats that benign would-block as fatal —
# aborting the socket and (before the in-session resume) dropping the whole voice
# session to IDLE. Tripling the buffer + window to 16 KB lets a brief stall be
# absorbed instead of stalling the writer to a write-0. PSRAM is plentiful (8 MB),
# so the extra per-socket TCP memory is free here.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384
